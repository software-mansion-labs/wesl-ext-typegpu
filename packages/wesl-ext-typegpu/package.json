{
  "name": "wesl-ext-typegpu",
  "version": "0.1.0-alpha.2",
  "description": "A WESL extension that enables reflection of WESL code into JS through TypeGPU definitions.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./suffixes": {
      "types": "./suffixes.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/prepublishOnly.mjs && tsdown"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./suffixes": {
        "types": "./suffixes.d.ts"
      }
    }
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE.md",
    "suffixes.d.ts",
    "dist/**"
  ],
  "sideEffects": false,
  "keywords": [
    "wesl",
    "plugin",
    "extension",
    "typegpu",
    "wgsl",
    "webgpu"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.6.3+sha512.bb45e34d50a9a76e858a95837301bfb6bd6d35aea2c5d52094fa497a467c43f5c440103ce2511e9e0a2f89c3d6071baac3358fc68ac6fb75e2ceb3d2736065e6",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wesl": "^0.7.31",
    "wesl-plugin": "^0.6.81"
  },
  "peerDependencies": {
    "wesl": "^0.7.31",
    "wesl-plugin": "^0.6.81"
  },
  "dependencies": {
    "knitwork": "^1.2.0"
  }
}
